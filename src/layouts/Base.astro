---
import { u } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  heroHeader?: boolean;
}
const {
  title,
  description = 'Swara Yoga as taught in the Shiva Swarodaya: understanding Prana through the flow of breath. Courses by Ma Shakti Devpriya.',
  heroHeader = false,
} = Astro.props;
const fullTitle = title === 'Home' ? 'Shiva Swarodaya · Swara Yoga with Ma Shakti Devpriya' : `${title} · Shiva Swarodaya`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {import.meta.env.PUBLIC_NOINDEX === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(u('/images/logo-640.webp'), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&family=Lora:ital,wght@0,400;0,500;1,400&family=Marcellus&family=Tiro+Devanagari+Sanskrit&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overHero={heroHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
