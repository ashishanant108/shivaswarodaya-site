---
import { u } from '../lib/url';
// Fonts are served from the site itself (no Google Fonts request). Each file
// below is split by script, so the browser downloads only the parts it needs.
import '@fontsource/marcellus/400.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/tiro-devanagari-sanskrit/400.css';
import marcellusLatin from '@fontsource/marcellus/files/marcellus-latin-400-normal.woff2?url';
import loraLatin from '@fontsource/lora/files/lora-latin-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  heroHeader?: boolean;
  /** 1200×630 JPG in public/og/, shown when the page is shared */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
}
const {
  title,
  description = 'Swara Yoga as taught in the Shiva Swarodaya: understanding Prana through the flow of breath. Courses by Ma Shakti Devpriya.',
  heroHeader = false,
  ogImage = '/og/default.jpg',
  ogImageAlt = 'Shiva Swarodaya · Swara Yoga with Ma Shakti Devpriya',
  ogType = 'website',
} = Astro.props;
const ogImageUrl = new URL(u(ogImage), Astro.site);
const fullTitle = title === 'Home' ? 'Shiva Swarodaya · Swara Yoga with Ma Shakti Devpriya' : `${title} · Shiva Swarodaya`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {import.meta.env.PUBLIC_NOINDEX === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={u('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="manifest" href={u('/site.webmanifest')} />
    <meta name="theme-color" content="#000000" />
    <!-- Sharing cards (WhatsApp, Facebook, LinkedIn, X) -->
    <meta property="og:site_name" content="Shiva Swarodaya" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="preload" href={marcellusLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={loraLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overHero={heroHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
