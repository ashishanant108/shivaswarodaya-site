---
import { getCollection } from 'astro:content';
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { social } from '../data/site';

const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
const youtube = social.find((s) => s.id === 'youtube')?.href || '';
const placeholders = Math.max(0, 6 - videos.length);
---
<Base title="Videos" description="Short introductions to Swara Yoga and the Shiva Swarodaya by Ma Shakti Devpriya." ogImage="/og/default.jpg">
  <PageIntro
    sanskrit="दर्शन"
    eyebrow="Watch"
    title="Videos"
    lede="Short introductions to Swara Yoga and the Shiva Swarodaya by Ma Shakti Devpriya."
  />

  <section class="section" style="padding-top: 8px">
    <div class="container">
      <ul class="grid">
        {videos.map((v) => (
          <li class="video">
            <a class="thumb" href={`https://www.youtube.com/watch?v=${v.data.youtubeId}`} target="_blank" rel="noopener" aria-label={`${v.data.title} (opens YouTube in a new tab)`}>
              <img src={`https://i.ytimg.com/vi/${v.data.youtubeId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
              <span class="play" aria-hidden="true"></span>
            </a>
            <h2>{v.data.title}</h2>
            <p>{v.data.summary}</p>
          </li>
        ))}
        {Array.from({ length: placeholders }).map((_, i) => (
          <li class="video soon">
            <div class="thumb">
              <span class="soon-dev" lang="sa" aria-hidden="true">स्वर</span>
              <span class="play" aria-hidden="true"></span>
            </div>
            <h2>Coming soon</h2>
            <p>Video {videos.length + i + 1} of the introductory series.</p>
          </li>
        ))}
      </ul>

      <div class="subscribe">
        <p>New videos appear on YouTube first.</p>
        {youtube && youtube !== '#'
          ? <a class="btn btn-primary" href={youtube} target="_blank" rel="noopener">Subscribe on YouTube</a>
          : <a class="btn btn-ghost" href={u('/courses/meet-your-swara')}>Meanwhile, begin “Meet your Swara”</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px 28px; }
  .video h2 { font-size: 21px; margin: 14px 0 6px; }
  .video p { margin: 0; color: var(--muted); font-size: 16px; }
  .thumb { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: radial-gradient(ellipse at 50% 120%, #3A2A1E 0%, #1A1412 60%, #000 100%); }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .thumb::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, #9D7636, #F2D9A0, #9D7636); }
  .play { position: relative; width: 56px; height: 56px; border-radius: 50%; background: rgba(0, 0, 0, .55); border: 1px solid rgba(226, 198, 142, .7); }
  .play::before { content: ''; position: absolute; left: 22px; top: 18px; border-left: 16px solid var(--gold-light); border-top: 10px solid transparent; border-bottom: 10px solid transparent; }
  a.thumb:hover .play { background: var(--kumkum); }
  .soon .soon-dev { position: absolute; font: 400 64px/1 var(--font-sanskrit); color: rgba(226, 198, 142, .18); }
  .soon .play { opacity: .6; }
  .soon h2 { color: var(--muted); }
  .subscribe { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; border-top: 1px solid var(--rule); padding-top: 28px; }
  .subscribe p { margin: 0; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
