---
// Old address of the foundation course page; sends visitors to the new one.
import { u } from '../../lib/url';
const to = u('/courses/foundation');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Foundation course</title>
  </head>
  <body><p><a href={to}>The foundation course has moved here.</a></p></body>
</html>
