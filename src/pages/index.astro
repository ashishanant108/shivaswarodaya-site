---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import HeroAnimated from '../components/HeroAnimated.astro';

const path = [
  { term: 'Breath', dev: 'श्वास', text: 'The movement of air that anyone can observe.' },
  { term: 'Swara', dev: 'स्वर', text: 'Which nostril the breath flows through, and how that changes during the day.' },
  { term: 'Nadi', dev: 'नाडी', text: 'The channels of Prana: Ida on the left, Pingala on the right, Sushumna at the centre.' },
  { term: 'Prana', dev: 'प्राण', text: 'The life force whose movement the breath reflects.' },
  { term: 'Tattva', dev: 'तत्त्व', text: 'The five elements, which the Shiva Swarodaya describes as arising in turn within each Swara.' },
  { term: 'Awareness', dev: 'बोध', text: 'Where the study leads: steady attention to what is subtle.' },
];
---
<Base title="Home" heroHeader>
  <HeroAnimated />

  <section class="section intro" id="intro">
    <div class="container intro-grid">
      <div class="prose">
        <p class="eyebrow">Swara Yoga · Shiva Swarodaya</p>
        <h1>The breath is visible. Prana is subtle.</h1>
        <p class="lede">Swara Yoga is the traditional study of Prana through the flow of breath. Its principal text, the Shiva Swarodaya, is a dialogue in which Shiva explains this knowledge to Parvati.</p>
        <p>This site introduces that teaching carefully, in plain language, as it is practised in a living tradition.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={u('/courses/meet-your-swara')}>Begin “Meet your Swara” · 7 days, free</a>
          <a class="btn btn-ghost" href={u('/about')}>What is Swara Yoga?</a>
        </div>
      </div>
      <svg class="nadi" viewBox="0 0 120 240" role="img" aria-labelledby="nadi-title">
        <title id="nadi-title">Ida and Pingala crossing around the central Sushumna</title>
        <line x1="60" y1="10" x2="60" y2="230" stroke="#B9AE9E" stroke-width="1.2" />
        <path d="M60 14 C18 40,18 70,60 96 S102 150,60 176 S18 206,60 226" fill="none" stroke="var(--ida)" stroke-width="2" />
        <path d="M60 14 C102 40,102 70,60 96 S18 150,60 176 S102 206,60 226" fill="none" stroke="var(--pingala)" stroke-width="2" />
        <circle cx="60" cy="226" r="4" fill="var(--kumkum)" />
        <text x="4" y="58" font-size="9" fill="var(--ida)" font-family="Jost, sans-serif">Ida</text>
        <text x="86" y="58" font-size="9" fill="#8F4A1E" font-family="Jost, sans-serif">Pingala</text>
      </svg>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <p class="eyebrow">The path of study</p>
      <h2>From breath to awareness</h2>
      <ol class="path">
        {path.map((p) => (
          <li>
            <span class="dev sanskrit" lang="sa">{p.dev}</span>
            <h3>{p.term}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container course">
      <div class="prose">
        <p class="eyebrow">Free course</p>
        <h2>Meet your Swara</h2>
        <p>Seven short, pre-recorded lessons to begin observing your own breath the way the tradition describes. No experience needed. Each day takes a few minutes of watching and a few minutes of quiet practice.</p>
        <p class="meta">7 days · pre-recorded · free</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={u('/courses/meet-your-swara')}>Enrol free</a>
          <a class="btn btn-ghost" href={u('/courses')}>All courses</a>
        </div>
      </div>
      <aside class="next">
        <p class="eyebrow">Afterwards</p>
        <h3>Swara Yoga Sadhana</h3>
        <p>The foundation course, for those who want to study and practise systematically.</p>
        <a href={u('/courses/swara-yoga-sadhana')}>About the foundation course →</a>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="container teacher">
      <img src={u('/images/ma-portrait.webp')} alt="Ma Shakti Devpriya" width="520" height="605" loading="lazy" />
      <div class="prose">
        <p class="eyebrow">The teacher</p>
        <h2>Ma Shakti Devpriya</h2>
        <p>Ma Shakti Devpriya teaches in the Sri Vidya Krama tradition and is a co-founder of The Shakti Multiversity. Her areas of teaching include Swara Yoga, Tantra and traditional symbolism.</p>
        <div class="btn-row">
          <a class="btn btn-ghost" href={u('/about')}>About Ma</a>
          <a class="btn btn-ghost" href={u('/lineage')}>The lineage</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .nadi { width: clamp(90px, 12vw, 140px); height: auto; }
  @media (max-width: 720px) { .intro-grid { grid-template-columns: 1fr; } .nadi { display: none; } }

  .path { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; }
  .path li { background: var(--stone); padding: 24px 24px; }
  .path .dev { display: block; font-size: 20px; margin-bottom: 6px; }
  .path h3 { margin-bottom: 8px; }
  .path p { margin: 0; color: var(--muted); font-size: 16px; }
  @media (max-width: 860px) { .path { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .path { grid-template-columns: 1fr; } .path li { padding: 22px 20px; } }

  .course { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .meta { font: 500 13px/1 var(--font-ui); letter-spacing: .08em; text-transform: uppercase; color: var(--gold-text); margin-bottom: 20px; }
  .next { border-left: 1px solid var(--gold-soft); padding-left: 28px; }
  .next p { color: var(--muted); }
  .next a { font: 500 15px var(--font-ui); text-decoration: none; }
  @media (max-width: 760px) { .course { grid-template-columns: 1fr; } .next { border-left: 0; border-top: 1px solid var(--gold-soft); padding: 28px 0 0; } }

  .teacher { display: grid; grid-template-columns: 280px 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .teacher img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 999px 999px 14px 14px; }
  @media (max-width: 640px) { .teacher { grid-template-columns: 1fr; } .teacher img { width: min(240px, 70%); } }
</style>
