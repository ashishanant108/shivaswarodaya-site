---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { contactEmail, formEndpoint } from '../data/site';
---
<Base title="Contact" description="Write to Shiva Swarodaya with questions about Swara Yoga and the courses with Ma Shakti Devpriya." ogImage="/og/default.jpg">
  <PageIntro
    sanskrit="सम्पर्क"
    eyebrow="Write to us"
    title="Contact"
    lede="For questions about the courses or the teaching, write to us. We usually reply within a few days."
  />

  <section class="section">
    <div class="container layout">
      <form class="form" id="contact-form" data-endpoint={formEndpoint} novalidate>
        <input type="hidden" name="form" value="contact" />
        <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="c-email">Email address</label>
          <input id="c-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="c-topic">About</label>
          <select id="c-topic" name="topic">
            <option>Meet your Swara (free course)</option>
            <option>Foundation course (online)</option>
            <option>Sadhana & Practice (in person)</option>
            <option>Annual retreat</option>
            <option>Weekly sessions</option>
            <option>The teaching and lineage</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="c-msg">Your message</label>
          <textarea id="c-msg" name="message" rows="6" required></textarea>
        </div>
        <p class="small">We use your details only to reply to you. See our <a href={u('/privacy')}>privacy policy</a>.</p>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p id="c-status" class="status" role="status" aria-live="polite"></p>
      </form>

      <aside class="side">
        <div class="box">
          <h2>Email</h2>
          {contactEmail
            ? <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
            : <p class="muted">The contact email will be added here.</p>}
        </div>
        <div class="box">
          <h2>Follow</h2>
          <p class="muted">New videos and course dates are shared here first.</p>
          <SocialLinks showLabels />
        </div>
        <div class="box">
          <h2>Before you write</h2>
          <p class="muted">Many questions about Swara Yoga are answered on the <a href={u('/about')}>About</a> page, and questions about the free course on the <a href={u('/courses/meet-your-swara')}>Meet your Swara</a> page.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Pre-select the topic when arriving from a course page (?topic=...).
  const want = new URLSearchParams(location.search).get('topic');
  const sel = document.getElementById('c-topic') as HTMLSelectElement | null;
  if (want && sel) { const o = Array.from(sel.options).find((x) => x.text === want); if (o) sel.value = o.value; }

  // Sends the message to the Google Sheet (formEndpoint in src/data/site.ts), which emails a notification.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('c-status');
  const say = (t: string) => { if (status) status.textContent = t; };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const firstInvalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')).find((el) => !el.value.trim() || !el.checkValidity());
    if (firstInvalid) { say('Please fill in your name, a valid email address and your message.'); firstInvalid.focus(); return; }
    const url = form.dataset.endpoint;
    if (!url) { say('Thank you. (Preview only: the form is not connected yet.)'); return; }
    const button = form.querySelector('button'); if (button) button.disabled = true;
    say('Sending…');
    try {
      await fetch(url, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(new FormData(form) as any) });
      form.reset(); say('Thank you. Your message has been sent, and we will reply by email.');
    } catch { say('Sorry, that did not go through. Please try again, or write to us by email.'); }
    finally { if (button) button.disabled = false; }
  });
</script>

<style>
  .layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .form { display: grid; gap: 18px; background: var(--stone-2); border: 1px solid var(--rule); border-radius: 16px; padding: clamp(22px, 3vw, 32px); }
  .field { display: grid; gap: 6px; }
  .field label { font: 500 14px/1.2 var(--font-ui); color: var(--ink); }
  .field input, .field select, .field textarea { font: 400 16px/1.5 var(--font-ui); padding: 12px 14px; min-height: 46px; border: 1px solid var(--gold-line); border-radius: 10px; background: #FFFDF8; color: var(--ink); width: 100%; }
  .field textarea { resize: vertical; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--gold-text); outline-offset: 2px; }
  .form .btn { justify-self: start; border: 0; cursor: pointer; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .small { margin: 0; font: 400 14px/1.5 var(--font-ui); color: var(--muted); }
  .status { margin: 0; min-height: 1.4em; font: 400 14px/1.4 var(--font-ui); color: var(--kumkum); }
  .side { display: grid; gap: 16px; }
  .box { border: 1px solid var(--rule); border-radius: 14px; padding: 22px 24px; background: var(--stone); }
  .box h2 { font-size: 22px; margin-bottom: 8px; }
  .box p { margin-bottom: 12px; }
  .box p:last-child { margin-bottom: 0; }
  .muted { color: var(--muted); font-size: 16px; }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; }
    .form .btn { justify-self: stretch; }
  }
</style>
