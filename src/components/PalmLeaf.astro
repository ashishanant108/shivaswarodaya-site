---
/**
 * A Sanskrit verse presented on a palm leaf, in the style of a traditional
 * tala-patra manuscript: a long leaf with grain, two string holes and a
 * thread, with the verse written across it.
 * Only use verses checked against a named edition (see Tracker A-21).
 */
interface Props {
  lines: string[];          // Devanagari, one entry per half-verse
  number?: string;          // e.g. "॥ २१ ॥"
}
const { lines, number } = Astro.props;
---
<figure class="leaf-wrap">
  <div class="leaf" lang="sa">
    <span class="hole left" aria-hidden="true"></span>
    <span class="hole right" aria-hidden="true"></span>
    <blockquote class="text">
      {lines.map((l) => <p>{l}</p>)}
      {number && <p class="num">{number}</p>}
    </blockquote>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .leaf-wrap { margin: 0; }
  .leaf {
    position: relative;
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(26px, 4vw, 40px) clamp(56px, 9vw, 110px);
    border-radius: 48px / 50%;
    background:
      repeating-linear-gradient(180deg, rgba(120, 82, 30, .10) 0 1px, transparent 1px 7px),
      linear-gradient(180deg, #EBD29A 0%, #E0BF7E 45%, #D4AE6A 100%);
    box-shadow: inset 0 0 0 1px rgba(120, 82, 30, .35), inset 0 0 28px rgba(120, 82, 30, .25), 0 10px 24px -14px rgba(60, 35, 10, .45);
  }
  /* a thread through both holes */
  .leaf::before {
    content: ''; position: absolute; left: -18px; right: -18px; top: 50%; height: 1px;
    background: linear-gradient(90deg, transparent, #7A1F14 8%, transparent 14%, transparent 86%, #7A1F14 92%, transparent);
    opacity: .7;
  }
  .hole { position: absolute; top: 50%; width: 12px; height: 12px; margin-top: -6px; border-radius: 50%; background: var(--stone); box-shadow: inset 0 1px 2px rgba(60, 35, 10, .6); }
  .section.alt .hole { background: var(--stone-2); }
  .hole.left { left: clamp(22px, 4vw, 44px); }
  .hole.right { right: clamp(22px, 4vw, 44px); }

  .text { margin: 0; text-align: center; }
  .text p { margin: 0; font: 400 clamp(20px, 2.6vw, 28px)/1.7 var(--font-sanskrit); color: #3B2410; text-shadow: 0 1px 0 rgba(255, 245, 220, .45); }
  .text .num { font-size: clamp(16px, 1.8vw, 19px); color: #6B3A16; margin-top: 4px; }

  figcaption { max-width: 64ch; margin: 22px auto 0; text-align: center; }

  @media (max-width: 560px) {
    .leaf { border-radius: 28px; padding: 24px 34px; }
    .hole.left { left: 12px; } .hole.right { right: 12px; }
    .text p { font-size: 18px; line-height: 1.8; }
  }
</style>
